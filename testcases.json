  {
    "id": "32.x/EMERG",
    "title": "EMERGENCY_STATUS non-zero during an emergency",
    "query": "field:emergency_status!=0"
  },
  {
    "id": "32.x/MODE",
    "title": "LOCO_MODE reported",
    "query": "field:LOCO_MODE"
  },
  {
    "id": "SEC/CBC",
    "title": "Authentication rejection surfaced",
    "query": "\"PACKET REJECTED\" OR \"INVALID CBC MAC\"",
    "note": "Not a SIF clause: an integrity failure that must be visible if it occurs at any point during the run."
  },
  {
    "id": "32.x/SOS-EMERG",
    "title": "SOS input is followed by an emergency status",
    "given": "field:dmi1_sos_no=1",
    "then": "field:emergency_status!=0",
    "within_ms": 5000
  },
  {
    "_comment": "One shape, three numbered SIF clauses. The trigger and the result are identical; only the mode the loco starts in differs, which is exactly what 'expand' is for.",
    "id": "32.x/STANDBY-{code}",
    "title": "From {mode_name}, entering Stand_By when no cab is active",
    "sequence": [
      {
        "label": "in {mode_name}",
        "match": "field:loco_mode={mode}"
      },
      {
        "label": "no cab active",
        "match": "field:cab1_active=inactive field:cab2_active=inactive",
        "within_ms": 0
      },
      {
        "label": "Stand_By",
        "match": "field:loco_mode=stand_by",
        "within_ms": 10000
      }
    ],
    "expand": [
      {
        "code": "FS",
        "mode": "4",
        "mode_name": "Full Supervision"
      },
      {
        "code": "LS",
        "mode": "3",
        "mode_name": "Limited Supervision"
      },
      {
        "code": "SR",
        "mode": "2",
        "mode_name": "Staff Responsible"
      },
      {
        "code": "OS",
        "mode": "6",
        "mode_name": "On Sight"
      }
    ]
  },
  {
    "id": "32.x/CAB-ACTIVE",
    "title": "Loco leaves Stand_By once a cab is made active",
    "sequence": [
      {
        "label": "in Stand_By",
        "match": "field:loco_mode=stand_by"
      },
      {
        "label": "cab activated",
        "match": "field:cab1_active=active",
        "within_ms": 0
      },
      {
        "label": "mode changed",
        "match": "field:loco_mode!=stand_by",
        "within_ms": 10000
      }
    ]
  },
  {
    "_comment": "Foreign tag: ONE trigger with several required consequences. They arrive in different packets and in no guaranteed order, but every one is required \u2014 a case that passed when only two of four happened would be worse than no check.",
    "id": "32.x/FOREIGN-TAG",
    "title": "Foreign tag causes SR mode, emergency brake and loss of position report",
    "sequence": [
      {
        "label": "foreign tag reported",
        "match": "field:tag_link_info!=0 OR \"foreign\" OR \"FOREIGN\""
      },
      {
        "label": "loco reacts",
        "within_ms": 15000,
        "all_of": [
          {
            "label": "Staff Responsible mode",
            "match": "field:loco_mode=staff_responsible"
          },
          {
            "label": "brake applied",
            "match": "field:brake_applied!=0"
          },
          {
            "label": "emergency status set",
            "match": "field:emergency_status!=0"
          }
        ]
      }
    ],
    "note": "TAG_LINK_INFO is a 3-bit field whose non-zero codes are not yet labelled in the schema \u2014 confirm which code means 'foreign' and tighten this to that value. The text alternatives catch the DMI/diagnostic wording in the meantime."
  },
  {
    "id": "SEC/KEY-EXPIRY",
    "title": "Authentication key set still valid with usable margin",
    "query": "field:key_days_remaining>14",
    "note": "AUTH_KEYS is a multi-line text block, reassembled from the separate datagrams its lines arrive in. REMAINING_KEYS_LESS_THAN_5 and SESSION_KEY_MISMATCH are both loco health faults, so a set close to expiry predicts a fault rather than reporting one."
  },
  {
    "id": "SEC/KEY-PRESENT",
    "title": "Loco reports its authentication key sets",
    "query": "field:auth_keys~key set"
  }
]
