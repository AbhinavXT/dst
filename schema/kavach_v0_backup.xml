<?xml version="1.0" encoding="UTF-8"?>
<!-- Kavach packet schema.
     To add a FIELD: copy a <field/> line inside the right struct/packet and
     edit name/bits. To add a whole STRUCT: copy a <struct>..</struct> block.
     Field order top to bottom == wire order. -->
<schema version="1">

  <enums>
    <enum name="speed6">
      <map v="0"  label="dead-stop"/>
      <map from="1" to="50" formula="v*5" unit="km/h"/>
      <map from="51" to="61" label="reserved"/>
      <map v="62" label="8 km/h"/>
      <map v="63" label="unknown"/>
    </enum>
    <enum name="pktDir">
      <map v="0" label="Unidentified"/>
      <map v="1" label="Nominal"/>
      <map v="2" label="Reverse"/>
      <map v="3" label="Spare"/>
    </enum>
    <enum name="authType">
      <map v="0" label="Not to be used"/>
      <map v="1" label="OS Authority"/>
      <map v="2" label="FS Authority"/>
      <map v="3" label="SR Authority"/>
    </enum>
    <enum name="gradDir">
      <map v="0" label="downhill"/>
      <map v="1" label="uphill"/>
    </enum>
    <enum name="dupTagDir">
      <map v="0" label="Nominal(+)"/>
      <map v="1" label="Reverse(-)"/>
    </enum>
  </enums>

  <crcs>
    <crc name="anxc_jamcrc" type="crc32" poly="0x04C11DB7" init="0x00000000"
         reflect_in="true" reflect_out="true" xor_out="0xFFFFFFFF"
         trailer_bytes="4" trailer_endian="le"/>
    <crc name="anxd_crc30" type="crc30" poly="0x2030B9C7" init="0x3FFFFFFF"
         reflect_in="true" reflect_out="true" xor_out="0x3FFFFFFF"
         trailer_bits="30"/>
  </crcs>

  <!-- Station to Onboard regular packet (SLRP), Annexure-C C.4.2.
       wire msb-first: bit 0 is the MSB of byte 0. -->
  <packet name="SLRP" match="pkt_type==9" wire="msb-first" crc="anxc_jamcrc">
    <field name="PKT_TYPE"        bits="4"  id="pkt_type"/>
    <field name="PKT_LENGTH"      bits="10" unit="bytes"/>
    <field name="FRAME_NUM"       bits="17"/>
    <field name="SOURCE_STN_ID"   bits="16"/>
    <field name="STN_VERSION"     bits="3"/>
    <field name="DEST_LOCO_ID"    bits="20"/>
    <field name="REF_PROF_ID"     bits="4"/>
    <field name="LAST_REF_RFID"   bits="10" id="ref_rfid"/>
    <field name="DIST_PKT_START"  bits="15" signed="true" unit="m" id="dps"/>
    <field name="PKT_DIR"         bits="2"  enum="pktDir" id="pkt_dir"/>
    <pad   bits="3"/>

    <!-- byte-aligned sub-packets: read type+length, dispatch by type, repeat. -->
    <subpackets type_bits="4" len_bits="7" len_unit="bytes" reserve_tail="8">
      <case type="0" struct="MovementAuthority"/>
      <case type="1" struct="StaticSpeedProfile"/>
      <case type="2" struct="GradientProfile"/>
      <case type="3" struct="LCgateProfile"/>
      <case type="4" struct="TurnoutSpeed"/>
      <case type="5" struct="TagLinking"/>
      <case type="6" struct="TrackCondition"/>
      <case type="7" struct="TSR"/>
    </subpackets>
  </packet>

  <struct name="StaticSpeedProfile">
    <field name="LM_Speed_Info_CNT" bits="5" id="cnt"/>
    <repeat name="speed" count="cnt">
      <field name="distance"  bits="15" unit="m"/>
      <field name="class"     bits="1"  id="cls"/>
      <field name="universal" bits="6"  enum="speed6" when="cls==0"/>
      <field name="A"         bits="6"  enum="speed6" when="cls==1"/>
      <field name="B"         bits="6"  enum="speed6" when="cls==1"/>
      <field name="C"         bits="6"  enum="speed6" when="cls==1"/>
    </repeat>
  </struct>

  <struct name="GradientProfile">
    <field name="LM_Grad_Info_CNT" bits="5" id="cnt"/>
    <repeat name="grad" count="cnt">
      <field name="distance" bits="15" unit="m"/>
      <field name="dir"      bits="1"  enum="gradDir"/>
      <field name="value"    bits="5"/>
    </repeat>
  </struct>

  <struct name="TagLinking">
    <field name="DIST_DUP_TAG"   bits="4"/>
    <field name="ROUTE_RFID_CNT" bits="6" id="cnt"/>
    <repeat name="tag" count="cnt">
      <field name="DIST_NXT_RFID" bits="11" unit="m"/>
      <field name="NXT_RFID_TAG"  bits="10"/>
      <field name="DUP_TAG_DIR"   bits="1" enum="dupTagDir"/>
    </repeat>
  </struct>

  <struct name="TrackCondition">
    <field name="TRACKCOND_CNT" bits="4" id="cnt"/>
    <repeat name="tc" count="cnt">
      <field name="type"   bits="4"/>
      <field name="start"  bits="15" unit="m"/>
      <field name="length" bits="15" unit="m"/>
    </repeat>
  </struct>

  <struct name="MovementAuthority">
    <field name="FRAME_OFFSET"       bits="4"/>
    <field name="DEST_LOCO_SOS"      bits="4"/>
    <field name="TRAIN_SECTION_TYPE" bits="2"/>
    <field name="CUR_SIG_INFO"       bits="17"/>
    <field name="CUR_SIG_ASPECT"     bits="6"/>
    <field name="NEXT_SIG_ASPECT"    bits="6"/>
    <field name="APPR_SIG_DIST"      bits="15" unit="m"/>
    <field name="AUTHORITY_TYPE"     bits="2" enum="authType" id="at"/>
    <field name="AUTHORIZED_SPEED"   bits="6" enum="speed6" when="at==1"/>
    <field name="MA_W_R_T_SIG"       bits="16" unit="m"/>
  </struct>

</schema>
